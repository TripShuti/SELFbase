# ── SpacetimeDB ───────────────────────────────────────────────────────────────
SPACETIMEDB_DB_NAME=selfbase
# Public WebSocket URL the browser connects to
SPACETIMEDB_PUBLIC_URI=wss://spacetime.yourdomain.com
# Optional: same-origin proxy via the web app (single-route setup).
# Set this to your internal SpacetimeDB origin and set SPACETIMEDB_PUBLIC_URI to empty.
# Example:
# SPACETIMEDB_PUBLIC_URI=
# SPACETIMEDB_PROXY_ORIGIN=http://spacetimedb:3000
SPACETIMEDB_PROXY_ORIGIN=
# Identity token for the API gateway. Required for custom API endpoints (/api/e/*).
# Generate with: spacetime identity token --identity <your-identity>
# SPACETIMEDB_GATEWAY_TOKEN=

# Internal SpacetimeDB HTTP origin used by server-side routes (blob auth).
# Compose default (http://spacetimedb:3000) is correct in Docker; for native
# runs set http://localhost:3000.
# SPACETIMEDB_INTERNAL_URL=http://localhost:3000

# ── Next.js (baked into the browser bundle at image build time) ───────────────
NEXT_PUBLIC_SPACETIMEDB_URI=wss://spacetime.yourdomain.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=selfbase
NEXT_PUBLIC_SPACETIMEAUTH_CLIENT_ID=
NEXT_PUBLIC_SPACETIMEAUTH_AUTHORITY=

# ── Garage / S3-compatible blob storage ──────────────────────────────────────
# Defaults in docker-compose point the web app at the bundled Garage service
# (MinIO's replacement — MinIO is EOL upstream). Garage imports
# S3_ACCESS_KEY/S3_SECRET_KEY on first boot, so these three lines are the whole
# credential story. NOTE: Garage requires secrets ≥16 characters — the old
# MinIO-era `minioadmin` defaults will NOT import; attachments stored in an old
# minio-data volume must be re-uploaded or copied over with an S3 sync tool.
# Override to use external storage (e.g. Cloudflare R2, AWS S3):
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_BUCKET=pear-attachments
#   S3_ACCESS_KEY=...
#   S3_SECRET_KEY=...
S3_ENDPOINT=http://garage:3900
# Optional. Browser upload URL for presigned PUTs. If unset, the app uses the request host + :9000 (works with zero config when app and Garage are on the same host — compose publishes Garage's S3 API on host port 9000). Set only when storage is on a different host or port.
# S3_PUBLIC_ENDPOINT=http://other-host:9000
S3_BUCKET=selfbase-attachments
S3_ACCESS_KEY=selfbase-access-key
S3_SECRET_KEY=selfbase-secret-key-change-me
S3_REGION=us-east-1

# ── Docker images ─────────────────────────────────────────────────────────────
# Push target for your registry; compose builds locally when unset.
# WEB_IMAGE=registry.yourdomain.com/team/app-web:latest

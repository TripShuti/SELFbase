# ── SpacetimeDB ───────────────────────────────────────────────────────────────
SPACETIMEDB_DB_NAME=selfbase
# Public WebSocket URL the browser connects to
SPACETIMEDB_PUBLIC_URI=wss://spacetime.yourdomain.com
# Optional: same-origin proxy via the web app (single-route setup).
# Set this to your internal SpacetimeDB origin and set SPACETIMEDB_PUBLIC_URI to empty.
# Example:
# SPACETIMEDB_PUBLIC_URI=
# SPACETIMEDB_PROXY_ORIGIN=http://spacetimedb:3000
SPACETIMEDB_PROXY_ORIGIN=
# Identity token for the API gateway. There is no separate gateway token:
# custom API endpoints (/api/e/*) use the database owner's token configured as
# SELFBASE_STDB_TOKEN (see the "Server API" section below).

# Internal SpacetimeDB HTTP origin used by server-side routes (blob auth).
# Compose default (http://spacetimedb:3000) is correct in Docker; for native
# runs set http://localhost:3000.
# SPACETIMEDB_INTERNAL_URL=http://localhost:3000

# ── Next.js (baked into the browser bundle at image build time) ───────────────
# Compose maps these to NEXT_PUBLIC_SPACETIMEAUTH_* build args. For a native
# `pnpm dev` run set NEXT_PUBLIC_SPACETIMEAUTH_CLIENT_ID and
# NEXT_PUBLIC_SPACETIMEAUTH_AUTHORITY directly instead.
SPACETIMEAUTH_CLIENT_ID=
SPACETIMEAUTH_AUTHORITY=
# Extra SpacetimeDB hosts accepted by `?ws=` deep links, comma-separated
# (host or host:port). The page's own host and SPACETIMEDB_PUBLIC_URI's host are
# always trusted; list any additional servers here.
# ALLOWED_WORKSPACE_HOSTS=other-stdb.example.com:3000

# ── Garage / S3-compatible blob storage ──────────────────────────────────────
# ⚠ The values below (and the matching fallbacks in docker-compose.yml) are
# PUBLIC defaults. Change GARAGE_RPC_SECRET, GARAGE_ADMIN_TOKEN, S3_ACCESS_KEY
# and S3_SECRET_KEY before exposing this stack to any network. Generate each
# secret with: openssl rand -hex 32 (Garage requires ≥16 characters).
#
# Defaults in docker-compose point the web app at the bundled Garage service
# (MinIO's replacement — MinIO is EOL upstream). Garage imports
# S3_ACCESS_KEY/S3_SECRET_KEY on first boot, so these three lines are the whole
# credential story. NOTE: Garage requires secrets ≥16 characters — the old
# MinIO-era `minioadmin` defaults will NOT import; attachments stored in an old
# minio-data volume must be re-uploaded or copied over with an S3 sync tool.
# Override to use external storage (e.g. Cloudflare R2, AWS S3):
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_BUCKET=selfbase-attachments
#   S3_ACCESS_KEY=...
#   S3_SECRET_KEY=...
S3_ENDPOINT=http://garage:3900
# Optional. Browser upload URL for presigned PUTs. If unset, the app uses the request host + :9000 (works with zero config when app and Garage are on the same host — compose publishes Garage's S3 API on host port 9000). Set only when storage is on a different host or port.
# S3_PUBLIC_ENDPOINT=http://other-host:9000
S3_BUCKET=selfbase-attachments
S3_ACCESS_KEY=selfbase-access-key
S3_SECRET_KEY=selfbase-secret-key-change-me
S3_REGION=us-east-1

# ── Docker images ─────────────────────────────────────────────────────────────
# Push target for your registry; compose builds locally when unset.
# WEB_IMAGE=registry.yourdomain.com/team/app-web:latest
# When pulling a registry image also set WEB_PULL_POLICY=always (compose
# otherwise builds the local context and ignores WEB_IMAGE).
# WEB_PULL_POLICY=always

# ── Host ports ────────────────────────────────────────────────────────────────
# Override when the defaults are taken (e.g. Dockhand occupies :3000).
# SPACETIMEDB_HOST_PORT=3011
# WEB_HOST_PORT=3012
# GARAGE_HOST_PORT=9000
# NOTE: if GARAGE_HOST_PORT differs from 9000, also set S3_PUBLIC_ENDPOINT
# to http://<host>:<port> so browser downloads resolve (uploads go through
# the app and are unaffected).

# ── Server API / external data sources ────────────────────────────────────────
# Existing SpacetimeDB database owner's token (server-only; no NEXT_PUBLIC prefix).
# Needed for custom REST API handling and generic external-source credentials
# and background refresh. Do not mint a new identity for an existing database.
SELFBASE_STDB_TOKEN=
# SELFBASE_STDB_URL=http://spacetimedb:3000
EXTERNAL_SOURCE_SYNC_ENABLED=true
